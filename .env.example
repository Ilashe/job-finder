# Copy this file to .env and fill in the keys you have. Every key is free and optional:
# without them the tool still crawls all employer career sites.

# USAJOBS - all federal IT jobs in Illinois (series 2210/1550/0854...)
# Request a key: https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# CareerOneStop - US Dept. of Labor / National Labor Exchange (state job bank listings)
# Register: https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=

# Adzuna - aggregates thousands of US job boards (Illinois "IT Jobs" category)
# Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# People Data Labs - employee counts for any company + discovery of small Illinois employers
# Free key: https://www.peopledatalabs.com/signup   (commands: enrich-sizes, find-companies)
PDL_API_KEY=

# Optional tuning
# JOBFINDER_HOST_CONCURRENCY=4     # parallel requests per website (be polite)
# JOBFINDER_CONCURRENCY=24         # total parallel requests
# JOBFINDER_WORKDAY_MAX_PAGES=6
